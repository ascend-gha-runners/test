{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.0",
  "description": "Standardized E2E test case specifications and metadata catalog",
  "test_cases": [
    {
      "id": "TC-FEAT-PYPI",
      "name": "PyPI Cache & PyTorch Wheels (/whl) 缓存与 404 回源",
      "category": "platform-feature",
      "feature_doc": "https://ascend-gha-runners.github.io/docs/feature/#pypi-cache-port-80",
      "service_port": 80,
      "client": ["pip", "uv"],
      "workflow": ".github/workflows/e2e-feature-pypi-cache.yml",
      "engine_scenario": "pypi",
      "default_container": "swr.cn-southwest-2.myhuaweicloud.com/base_image/ascend-ci/cann:8.2.rc1.alpha003-910b-openeuler22.03-py3.11",
      "target_clusters": "all",
      "assertions": {
        "hard": [
          "pip/uv 依赖真实安装成功 (uc-manager, uv)",
          "无本地磁盘缓存命中 (禁止 Using cached)",
          "PyTorch 经 /whl/cpu 真实安装且 import torch 成功",
          "404 请求回退至 pypi-org 或返回标准 HTTP 404 兜底"
        ],
        "soft": [
          "响应头包含 X-Pypi-Cache (MISS -> HIT)"
        ],
        "probe": [
          "X-Cache-Tier 回源层级探针"
        ]
      }
    },
    {
      "id": "TC-FEAT-APT",
      "name": "Ubuntu APT 镜像缓存服务",
      "category": "platform-feature",
      "feature_doc": "https://ascend-gha-runners.github.io/docs/feature/#apt-cache-port-8081",
      "service_port": 8081,
      "client": ["apt-get"],
      "workflow": ".github/workflows/e2e-feature-apt-cache.yml",
      "engine_scenario": "apt",
      "default_container": "swr.cn-southwest-2.myhuaweicloud.com/base_image/ascend-ci/cann:9.0.0-a3-ubuntu22.04-py3.12",
      "target_clusters": "all",
      "assertions": {
        "hard": [
          "apt-get update -y 经 8081 成功刷新索引",
          "apt-get install -y 真实安装 git, zstd, gcc, cmake 构建依赖",
          "安装工具链二进制可执行且版本可读取"
        ],
        "soft": [],
        "probe": [
          "8081 根端口 HTTP 探测状态"
        ]
      }
    },
    {
      "id": "TC-FEAT-RUSTUP",
      "name": "Rust / rustup 工具链镜像缓存服务",
      "category": "platform-feature",
      "feature_doc": "https://ascend-gha-runners.github.io/docs/feature/#rust-rustup-cache-port-8082",
      "service_port": 8082,
      "client": ["rustup", "curl"],
      "workflow": ".github/workflows/e2e-feature-rustup-cache.yml",
      "engine_scenario": "rustup",
      "default_container": "swr.cn-southwest-2.myhuaweicloud.com/base_image/ascend-ci/cann:8.2.rc1.alpha003-910b-openeuler22.03-py3.11",
      "target_clusters": "all",
      "assertions": {
        "hard": [
          "经 8082 端口下载 rustup-init.sh 成功",
          "sh rustup-init.sh 真实安装 stable minimal 工具链成功",
          "rustc --version 与 cargo --version 可执行并返回有效版本"
        ],
        "soft": [
          "基本 Rust 源码编译测试通过"
        ],
        "probe": [
          "X-Rustup-Cache 缓存头"
        ]
      }
    },
    {
      "id": "TC-FEAT-YUM",
      "name": "openEuler YUM / DNF RPM 镜像缓存服务",
      "category": "platform-feature",
      "feature_doc": "https://ascend-gha-runners.github.io/docs/feature/#yum-dnf-cache-port-8083",
      "service_port": 8083,
      "client": ["dnf", "yum"],
      "workflow": ".github/workflows/e2e-feature-yum-cache.yml",
      "engine_scenario": "yum",
      "default_container": "swr.cn-southwest-2.myhuaweicloud.com/base_image/ascend-ci/cann:8.2.rc1.alpha003-910b-openeuler22.03-py3.11",
      "target_clusters": "all",
      "assertions": {
        "hard": [
          "dnf/yum makecache 经 8083 成功生成元数据缓存",
          "dnf/yum install -y 真实安装 git 与 zstd 成功",
          "git --version 与 zstd --version 可执行"
        ],
        "soft": [],
        "probe": [
          "8083 根路径连通性探针"
        ]
      }
    },
    {
      "id": "TC-FEAT-CRATES",
      "name": "crates.io Sparse Index 与 Crate 下载缓存服务",
      "category": "platform-feature",
      "feature_doc": "https://ascend-gha-runners.github.io/docs/feature/#cratesio-cache-port-8085",
      "service_port": 8085,
      "client": ["cargo"],
      "workflow": ".github/workflows/e2e-feature-crates-cache.yml",
      "engine_scenario": "crates",
      "default_container": "swr.cn-southwest-2.myhuaweicloud.com/base_image/ascend-ci/cann:8.2.rc1.alpha003-910b-openeuler22.03-py3.11",
      "target_clusters": "all",
      "assertions": {
        "hard": [
          "config.json 中 dl 路径重写为内网 8085 缓存服务",
          "cargo build 成功拉取 sparse 索引并编译第三方 crate (anyhow)",
          "编译生成的二进制正确执行并输出预期内容"
        ],
        "soft": [
          "X-Crates-Cache 下载头验证 (MISS -> HIT)",
          "config.json 由 rsproxy 一级源服务"
        ],
        "probe": [
          "上游 403 Access Denied 官方兜底机制 (PR #1722)"
        ]
      }
    },
    {
      "id": "TC-SCHED-DUAL-LABEL",
      "name": "全 13 集群 Runner [型号, 区域] 双标签调度与芯片识别",
      "category": "runner-scheduling",
      "feature_doc": "https://ascend-gha-runners.github.io/docs/user-manual-gha-zh/#runner-pod",
      "service_port": null,
      "client": ["gha-runner-scale-set"],
      "workflow": ".github/workflows/e2e-cluster-runners.yml",
      "engine_scenario": "cluster_runners",
      "default_container": null,
      "target_clusters": "all",
      "assertions": {
        "hard": [
          "双标签精准调度至目标集群与芯片型号",
          "基础 CPU 与 Python 算力自检通过",
          "NPU 节点驱动与设备文件 (/dev/davinci*) 存在"
        ],
        "soft": [
          "npu-smi info 可执行并正确输出芯片状态"
        ],
        "probe": [
          "cgroup 内存与 CPU 限额配额探针"
        ]
      }
    },
    {
      "id": "TC-PEP658-METADATA",
      "name": "PyTorch Simple Index PEP 658 Metadata 校验和完整性",
      "category": "index-integrity",
      "feature_doc": "https://ascend-gha-runners.github.io/docs/feature/#pypi-cache-port-80",
      "service_port": 80,
      "client": ["python", "pip"],
      "workflow": ".github/workflows/e2e-cross-cluster-pep658.yml",
      "engine_scenario": "pep658",
      "default_container": "swr.cn-southwest-2.myhuaweicloud.com/base_image/ascend-ci/cann:8.2.rc1.alpha003-910b-openeuler22.03-py3.11",
      "target_clusters": "all",
      "assertions": {
        "hard": [
          "元数据 SHA-256 校验和与 HTML 属性一致",
          "无残留 Checksum-SHA256 破坏行",
          "RFC 822 头部规范完整"
        ],
        "soft": [
          "缓存命中无损透传"
        ],
        "probe": [
          "全量 wheel 覆盖率抽样"
        ]
      }
    },
    {
      "id": "TC-E2E-USER-SCENARIOS",
      "name": "vLLM-Ascend 生产全链路用户端到端组合场景",
      "category": "user-scenario",
      "feature_doc": "https://ascend-gha-runners.github.io/docs/feature/",
      "service_port": 80,
      "client": ["pip", "uv", "cargo", "apt-get", "dnf", "git"],
      "workflow": ".github/workflows/e2e-user-scenarios.yml",
      "engine_scenario": "all",
      "default_container": "swr.cn-southwest-2.myhuaweicloud.com/base_image/ascend-ci/cann:8.2.rc1.alpha003-910b-openeuler22.03-py3.11",
      "target_clusters": "all",
      "assertions": {
        "hard": [
          "OS 包管理器安装通过 (8081 或 8083)",
          "Python + uv 组合安装通过 (80)",
          "Rust 工具链与 crate 编译通过 (8082 + 8085)",
          "Git 代理克隆通过"
        ],
        "soft": [
          "Crate 403 优雅容灾"
        ],
        "probe": [
          "各集群时延与网络吞吐指标"
        ]
      }
    },
    {
      "id": "TC-FEAT-A2-NGINX-CACHE",
      "name": "hk-001 A2 (gy-001/wlcb-001) nginx-pypi-cache(-new) 真实客户场景",
      "category": "platform-feature",
      "feature_doc": "https://ascend-gha-runners.github.io/docs/feature/",
      "service_port": 80,
      "client": ["pip", "apt-get", "dnf", "rustup", "go"],
      "workflow": ".github/workflows/e2e-hk001-a2-1-nginx-cache.yml",
      "engine_scenario": "native-clients",
      "default_container": "swr.cn-southwest-2.myhuaweicloud.com/base_image/ascend-ci/cann:8.2.rc1.alpha003-910b-openeuler22.03-py3.11",
      "target_clusters": "gy-001,wlcb-001",
      "assertions": {
        "hard": [
          "pip 经 :80 真实安装 PyPI 包并 import 成功 (gy001)",
          "pip 经 :80 /whl/cpu 真实安装 PyTorch 并 import torch (gy001)",
          "dnf 经 :8083 真实安装 git/zstd (openEuler)",
          "rustup 经 :8082 真实安装 stable 工具链并编译运行",
          "go 经 :8084 真实 go get/build",
          "apt-get 经 :8081 真实安装 git/zstd (Ubuntu)"
        ],
        "soft": [
          "X-Pypi-Cache / X-Rustup-Cache / X-Yum-Cache / X-Go-Cache / X-Cache-Status 命中头"
        ],
        "probe": [
          "wlcb001 cache 回源不稳定（nginx connect 110 超时）时回源类场景 WARN 降级，不阻塞"
        ]
      }
    },
    {
      "id": "TC-MODEL-SYNC-HK001",
      "name": "hk-001 / gy-001 / wlcb-001 三 runner ModelScope + HuggingFace 模型缓存一致性",
      "category": "storage-consistency",
      "feature_doc": "https://ascend-gha-runners.github.io/docs/",
      "service_port": null,
      "client": ["python", "filesystem"],
      "workflow": ".github/workflows/e2e-hk001-model-sync.yml",
      "engine_scenario": "model-cache-inventory",
      "default_container": "swr.cn-southwest-2.myhuaweicloud.com/base_image/ascend-ci/cann:8.2.rc1.alpha003-910b-openeuler22.03-py3.11",
      "target_clusters": "hk-001,gy-001,wlcb-001",
      "assertions": {
        "hard": [
          "以 hk-001 为基线，基线存在的模型在 gy-001 / wlcb-001 上必须存在",
          "ModelScope 与 HuggingFace 两个模型源分别独立比对"
        ],
        "soft": [
          "同名模型体积不一致时 WARN，不阻塞"
        ],
        "probe": [
          "非基线 runner 多出的模型仅记录；基线清单为空时跳过比对"
        ]
      }
    }
  ]
}
