{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.0",
  "description": "Standardized E2E test case specifications and metadata catalog",
  "test_cases": [
    {
      "id": "TC-FEAT-PYPI",
      "name": "PyPI Cache & PyTorch Wheels (/whl) 缓存与 404 回源",
      "category": "platform-feature",
      "feature_doc": "https://ascend-gha-runners.github.io/docs/feature/#pypi-cache-port-80",
      "service_port": 80,
      "client": ["pip", "uv"],
      "workflow": ".github/workflows/e2e-feature-pypi-cache.yml",
      "engine_scenario": "pypi",
      "default_container": "swr.cn-southwest-2.myhuaweicloud.com/base_image/ascend-ci/cann:8.2.rc1.alpha003-910b-openeuler22.03-py3.11",
      "target_clusters": "all",
      "assertions": {
        "hard": [
          "pip/uv 依赖真实安装成功 (uc-manager, uv)",
          "无本地磁盘缓存命中 (禁止 Using cached)",
          "华为昇腾专属源经 /ascend/repos/pypi 真实安装 triton-ascend 并验证 import triton",
          "空 venv 中经 /whl/cpu 安装固定 CPU PyTorch 及解析到的依赖并执行张量计算 (amd64)",
          "人工可选 torch/filelock/jinja2 各一个 wheel 字节 SHA-256 抽样，公布 metadata hash 时额外校验；不代表全量依赖",
          "虚构包 HTTP 404；回源层级另作证据，不以 404 单独证明回退",
          "空目标目录真实下载 idna==3.10，验证 pip 客户端备用内网索引恢复"
        ],
        "soft": [
          "响应头包含 X-Pypi-Cache (MISS -> HIT)"
        ],
        "probe": [
          "X-Cache-Tier 回源层级探针"
        ]
      }
    },
    {
      "id": "TC-FEAT-APT",
      "name": "Ubuntu APT 镜像缓存服务",
      "category": "platform-feature",
      "feature_doc": "https://ascend-gha-runners.github.io/docs/feature/#apt-cache-port-8081",
      "service_port": 8081,
      "client": ["apt-get"],
      "workflow": ".github/workflows/e2e-feature-apt-cache.yml",
      "engine_scenario": "apt",
      "default_container": "swr.cn-southwest-2.myhuaweicloud.com/base_image/ascend-ci/cann:9.0.0-a3-ubuntu22.04-py3.12",
      "target_clusters": "all",
      "assertions": {
        "hard": [
          "空 lists 仅经内网 8081 刷新索引，APT::Update::Error-Mode=any",
          "清空包缓存并 --reinstall git, zstd, gcc, cmake，断言内网下载证据",
          "安装工具链二进制可执行且版本可读取",
          "独立 lists/archive 下容忍 loopback 故障源，断言有效内网索引与 git deb 真实下载"
        ],
        "soft": [],
        "probe": [
          "8081 根端口 HTTP 探测状态"
        ]
      }
    },
    {
      "id": "TC-FEAT-RUSTUP",
      "name": "Rust / rustup 工具链镜像缓存服务",
      "category": "platform-feature",
      "feature_doc": "https://ascend-gha-runners.github.io/docs/feature/#rust-rustup-cache-port-8082",
      "service_port": 8082,
      "client": ["rustup", "curl"],
      "workflow": ".github/workflows/e2e-feature-rustup-cache.yml",
      "engine_scenario": "rustup",
      "default_container": "swr.cn-southwest-2.myhuaweicloud.com/base_image/ascend-ci/cann:8.2.rc1.alpha003-910b-openeuler22.03-py3.11",
      "target_clusters": "all",
      "assertions": {
        "hard": [
          "经 8082 端口下载 rustup-init.sh 成功",
          "sh rustup-init.sh 真实安装 stable minimal 工具链成功",
          "rustc --version 与 cargo --version 可执行并返回有效版本"
        ],
        "soft": [
          "基本 Rust 源码编译测试通过"
        ],
        "probe": [
          "X-Rustup-Cache 缓存头"
        ]
      }
    },
    {
      "id": "TC-FEAT-YUM",
      "name": "openEuler YUM / DNF RPM 镜像缓存服务",
      "category": "platform-feature",
      "feature_doc": "https://ascend-gha-runners.github.io/docs/feature/#yum-dnf-cache-port-8083",
      "service_port": 8083,
      "client": ["dnf", "yum"],
      "workflow": ".github/workflows/e2e-feature-yum-cache.yml",
      "engine_scenario": "yum",
      "default_container": "swr.cn-southwest-2.myhuaweicloud.com/base_image/ascend-ci/cann:8.2.rc1.alpha003-910b-openeuler22.03-py3.11",
      "target_clusters": "all",
      "assertions": {
        "hard": [
          "空 cachedir 仅经内网 8083 makecache 且元数据非空，不跳过失败 repo",
          "dnf install/reinstall git 与 zstd 成功并留存真实 RPM 下载证据",
          "git --version 与 zstd --version 可执行",
          "独立 cachedir 的双 baseurl 恢复：首 loopback 源失败、有效元数据及 RPM 真实下载"
        ],
        "soft": [],
        "probe": [
          "8083 根路径连通性探针"
        ]
      }
    },
    {
      "id": "TC-FEAT-CRATES",
      "name": "crates.io Sparse Index 与 Crate 下载缓存服务",
      "category": "platform-feature",
      "feature_doc": "https://ascend-gha-runners.github.io/docs/feature/#cratesio-cache-port-8085",
      "service_port": 8085,
      "client": ["cargo"],
      "workflow": ".github/workflows/e2e-feature-crates-cache.yml",
      "engine_scenario": "crates",
      "default_container": "swr.cn-southwest-2.myhuaweicloud.com/base_image/ascend-ci/cann:8.2.rc1.alpha003-910b-openeuler22.03-py3.11",
      "target_clusters": ["gy-006"],
      "assertions": {
        "hard": [
          "config.json 中 dl 路径重写为内网 8085 缓存服务",
          "空 registry 缓存 cargo build 下载固定 anyhow==1.0.75 并编译",
          "清除 target 后 cargo build --offline 真实重建",
          "编译生成的二进制正确执行并输出预期内容"
        ],
        "soft": [
          "X-Crates-Cache 下载头验证 (MISS -> HIT)",
          "config.json 由 rsproxy 一级源服务"
        ],
        "probe": [
          "上游 403 Access Denied 官方兜底机制 (PR #1722)"
        ]
      }
    },
    {
      "id": "TC-FEAT-GO",
      "name": "Go module 冷缓存下载、固定校验和与运行",
      "category": "platform-feature",
      "feature_doc": "https://ascend-gha-runners.github.io/docs/feature/",
      "service_port": 8084,
      "client": ["go"],
      "workflow": ".github/workflows/e2e-feature-go-cache.yml",
      "engine_scenario": "go",
      "default_container": "golang:1.23-bookworm",
      "target_clusters": "manual-single-cluster",
      "assertions": {
        "hard": [
          "空 GOMODCACHE 仅经内网 8084 下载 rsc.io/quote@v1.5.2 及依赖",
          "固定 go.sum 校验与 go mod verify 成功；GOSUMDB=off 不验证外部校验服务",
          "下载后 GOPROXY=off 真实 go run 输出预期字串",
          "独立空缓存 loopback 故障代理后由内网备用代理真实下载并运行",
          "真实模块 HTTP 200 与 X-Go-Cache 响应头"
        ],
        "soft": ["第二次请求 HIT"],
        "probe": ["虚构模块 HTTP 404；nginx 回源层级无证据为 not_verified"]
      }
    },
    {
      "id": "TC-SCHED-DUAL-LABEL",
      "name": "全 13 集群 Runner [型号, 区域] 双标签调度与芯片识别",
      "category": "runner-scheduling",
      "feature_doc": "https://ascend-gha-runners.github.io/docs/user-manual-gha-zh/#runner-pod",
      "service_port": null,
      "client": ["gha-runner-scale-set"],
      "workflow": ".github/workflows/e2e-cluster-runners.yml",
      "engine_scenario": "cluster_runners",
      "default_container": null,
      "target_clusters": "all",
      "assertions": {
        "hard": [
          "双标签精准调度至目标集群与芯片型号",
          "基础 CPU 与 Python 算力自检通过",
          "NPU 节点驱动与设备文件 (/dev/davinci*) 存在"
        ],
        "soft": [
          "npu-smi info 可执行并正确输出芯片状态"
        ],
        "probe": [
          "cgroup 内存与 CPU 限额配额探针"
        ]
      }
    },
    {
      "id": "TC-PEP658-METADATA",
      "name": "PyTorch Simple Index PEP 658 Metadata 校验和完整性",
      "category": "index-integrity",
      "feature_doc": "https://ascend-gha-runners.github.io/docs/feature/#pypi-cache-port-80",
      "service_port": 80,
      "client": ["python", "pip"],
      "workflow": ".github/workflows/e2e-cross-cluster-pep658.yml",
      "engine_scenario": "pep658",
      "default_container": "swr.cn-southwest-2.myhuaweicloud.com/base_image/ascend-ci/cann:8.2.rc1.alpha003-910b-openeuler22.03-py3.11",
      "target_clusters": "all",
      "assertions": {
        "hard": [
          "元数据 SHA-256 校验和与 HTML 属性一致",
          "无残留 Checksum-SHA256 破坏行",
          "RFC 822 头部规范完整"
        ],
        "soft": [
          "缓存命中无损透传"
        ],
        "probe": [
          "全量 wheel 覆盖率抽样"
        ]
      }
    }
  ]
}
